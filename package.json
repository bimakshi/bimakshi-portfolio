{
  "name": "bimakshi-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "npm run sitemap",
    "start": "next start",
    "lint": "next lint",
    "sitemap": "cross-env NODE_OPTIONS='--experimental-json-modules' node ./src/scripts/generateSitemap.mjs",
    "analyze": "cross-env ANALYZE=true next build",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,mdx,css,json}\"",
    "format:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,mdx,css,json}\""
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@tailwindcss/forms": "^0.5.6",
    "@vercel/analytics": "^1.3.1",
    "framer-motion": "^10.12.16",
    "lucide-react": "^0.366.0",
    "next": "15.0.5",
    "next-seo": "^6.4.0",
    "next-themes": "^0.2.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.10.1",
    "sharp": "^0.32.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.0.4",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "10.4.14",
    "cross-env": "^7.0.3",
    "eslint": "9.33.0",
    "eslint-config-next": "15.5.0",
    "globby": "^14.0.0",
    "postcss": "^8.4.47",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "3.3.0",
    "typescript": "5.1.3"
  }
